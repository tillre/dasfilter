mixin share-links(klass)
  .share-links(class=klass)
    ul
      li.facebook
        .fb-like(data-href=urls.full(), data-layout="button_count", data-action="like", data-show-faces="true", data-share="true")

mixin share-code
  #fb-root
  script.
    (function(d, s, id) {
      var js, fjs = d.getElementsByTagName(s)[0];
      if (d.getElementById(id)) return;
      js = d.createElement(s); js.id = id;
      js.src = "//connect.facebook.net/de_DE/sdk.js#xfbml=1&appId=750694388310848&version=v2.0";
      fjs.parentNode.insertBefore(js, fjs);
    }(document, 'script', 'facebook-jssdk'));

